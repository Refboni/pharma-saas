<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <!-- Configuracao do recurso JDBC para o servico no Tomcat -->
    <Resource name="jdbc/pharma_db"
              auth="Container"
              type="javax.sql.DataSource"
              maxTotal="100" 
              maxIdle="30" 
              maxWaitMillis="10000"
              username="root"
              password=""
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/pharma_db?useSSL=false&amp;allowPublicKeyRetrieval=true"/>
</Context>
